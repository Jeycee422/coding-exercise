<% content_for :title, @project.name %>

<article>
  <h1><%= @project.name %></h1>

  <% if @project.description.present? %>
    <p><%= @project.description %></p>
  <% end %>

  <section class="tasks">
    <h2>Tasks</h2>

<ul class="tasks">
  <% @project.tasks.select(&:persisted?).each do |task| %>
    <li class="task task--<%= task.status %>">
      <span class="task__title"><%= task.title %></span>
      <% if task.due_date %>
        <small>Due <%= task.due_date.strftime("%b %d, %Y") %></small>
      <% end %>
      <span class="task__status"><%= task.status.titleize %></span>

      <% unless task.status == "completed" %>
        <%= button_to "Mark Complete", project_task_path(@project, task), method: :patch %>
      <% end %>
    </li>
  <% end %>
</ul>

<h3>Add a task</h3>

<%= form_with model: [@project, @task] do |form| %>
  <% if @task.errors.any? %>
    <ul class="errors">
      <% @task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :due_date %>
    <%= form.date_field :due_date %>
  </div>

  <%= form.submit "Add task" %>
<% end %>
  </section>

  <div class="actions">
    <%= link_to "Edit Project", edit_project_path(@project), class: "button" %>
    <%= link_to "Back to Projects", projects_path, class: "button button-secondary" %>
    <%= button_to "Delete Project", @project, method: :delete, class: "button button-danger",
          form: { data: { turbo_confirm: "Delete this project?" } } %>
  </div>
</article>
