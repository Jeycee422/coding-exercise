<% content_for :title, "Projects" %>

<div class="page-header">
  <h1>Projects</h1>
  <%= link_to "New Project", new_project_path, class: "button" %>
</div>

<% if @projects.any? %>
  <ul class="project-list">
    <%= render @projects %>
  </ul>
<% else %>
  <p class="empty">No projects yet.</p>
<% end %>
